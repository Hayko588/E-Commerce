{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/v1/products/{**catch-all}" }
      },
      "ordering-route": {
        "ClusterId": "ordering",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/v1/orders/{**catch-all}" }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": { "primary": { "Address": "http://localhost:5002/" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      "ordering": {
        "Destinations": { "primary": { "Address": "http://localhost:5001/" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      }
    }
  }
}
